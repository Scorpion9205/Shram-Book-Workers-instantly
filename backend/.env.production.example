# Copy these into Railway's service -> Variables tab. Do not commit real values.

NODE_ENV=production
PORT=5000

# Neon.tech free Postgres connection string
DATABASE_URL=

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Upstash Redis — use the "rediss://" TLS connection string from the Upstash dashboard
REDIS_URL=

# CloudAMQP (or wherever RabbitMQ ends up) — "amqps://" TLS URL
RABBITMQ_URL=

RESEND_API_KEY=
EMAIL_FROM=

# Your production frontend domain (Vercel custom domain), no trailing slash
FRONTEND_URL=

AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# Switch to rzp_live_... once your Razorpay live keys are approved
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

EXOTEL_ACCOUNT_SID=
EXOTEL_SID=
EXOTEL_SUBDOMAIN=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SENDER_ID=
EXOTEL_FROM=

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
