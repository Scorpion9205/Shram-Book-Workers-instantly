generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  WORKER
  PROVIDER
  AGENT
}

enum JobStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum BookingStatus {
  CREATED
  PAYMENT_PENDING
  PAYMENT_CONFIRMED
  WORKER_ASSIGNED
  WORKER_EN_ROUTE
  OTP_VERIFIED
  WORK_STARTED
  WORK_COMPLETED
  PAYMENT_SETTLED
  REVIEWED
  CLOSED
  CANCELLED_BY_PROVIDER
  CANCELLED_BY_WORKER
  EXPIRED
  DISPUTED
}

enum BookingType {
  NORMAL_JOB
  INSTANT_REQUEST
  INSTANT_BIDDING
}

enum ProviderType {
  INDIVIDUAL
  COMPANY
}

enum InstantRequestStatus {
  OPEN
  FILLED
  EXPIRED
  CANCELLED
  COMPLETED
}

enum InstantResponseStatus {
  ACCEPTED
  REJECTED
}

enum ApplicantType {
  WORKER
  AGENT
}

enum BookingMode {
  DIRECT
  BIDDING
}

enum InstantBidStatus {
  ACTIVE
  SELECTED
  REJECTED
  WITHDRAWN
  EXPIRED
}

enum OtpPurpose {
  LOGIN
  WORK_START
  RESET_PASSWORD
}

enum OtpChannel {
  EMAIL
  SMS
}

enum RateUnit {
  HOURLY
  DAILY
  FIXED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum SupportTicketPriority {
  LOW
  MEDIUM
  HIGH
}

model User {
  payoutRequests      PayoutRequest[]
  id                  String               @id @default(uuid())
  name                String
  phone               String?              @unique
  email               String?              @unique
  passwordHash        String? // Optional: only for ADMIN / AGENT passwords
  googleId            String?              @unique
  role                UserRole
  isVerified          Boolean              @default(false)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  address             String?
  isActive            Boolean              @default(true)
  profileImage        String?
  city                String?
  pincode             String?
  state               String?
  deletedAt           DateTime? // Soft delete support
  agentProfile        AgentProfile?
  bookingsAsProvider  Booking[]            @relation("ProviderBookings")
  instantRequests     InstantRequest[]
  jobsPosted          Job[]                @relation("ProviderJobs")
  notifications       Notification[]
  providerProfile     ProviderProfile?
  providerReviews     Review[]             @relation("ProviderReviews")
  workerProfile       WorkerProfile?
  supportTickets      SupportTicket[]
  passwordResetTokens PasswordResetToken[]
}

// Forgot-password flow for password-based accounts (Admin/Agent) — a clickable-link token,
// not a user-typed code, so it can't reuse the Otp table's (identifier, code) access pattern:
// the reset link only carries the token, and tokenHash (a deterministic SHA-256 digest, not
// Argon2id) is looked up directly as the unique key. SHA-256 is intentionally used here instead
// of Argon2id — the token is a 256-bit crypto.randomBytes value, so its security comes from
// entropy, not from a slow verification hash, and a deterministic digest is what makes an
// O(1) lookup-by-token possible at all.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model WorkerProfile {
  id                      String                   @id @default(uuid())
  userId                  String                   @unique
  bio                     String?
  experience              Int                      @default(0)
  dailyRate               Decimal?
  isAvailable             Boolean                  @default(true)
  rating                  Float                    @default(0)
  totalJobs               Int                      @default(0)
  totalReviews            Int                      @default(0)
  latitude                Decimal?
  longitude               Decimal?
  // For agent-managed, phone-less workers paid via bank transfer — the Agent fills these in
  // and does the actual transfer manually outside the app; SHRAM only stores them for reference.
  bankAccountHolderName   String?
  bankAccountNumber       String?
  bankIfscCode            String?
  bankName                String?
  agentLinks              AgentWorker[]
  applications            Application[]
  bookings                Booking[]
  bookingWorkers          BookingWorker[]
  instantRequestResponses InstantRequestResponse[]
  reviews                 Review[]
  user                    User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills                  WorkerSkill[]
  instantBids             InstantRequestBid[]
  wallet                  Wallet?
}

model ProviderProfile {
  id           String       @id @default(uuid())
  userId       String       @unique
  companyName  String?
  description  String?
  rating       Float        @default(0)
  providerType ProviderType @default(INDIVIDUAL)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AgentProfile {
  id           String        @id @default(uuid())
  userId       String        @unique
  agencyName   String
  description  String?
  rating       Float         @default(0)
  city         String?
  createdAt    DateTime      @default(now())
  isVerified   Boolean       @default(false)
  phone        String?
  profileImage String?
  state        String?
  updatedAt    DateTime      @updatedAt
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  workers      AgentWorker[]
  applications Application[]
  bookings     Booking[]
}

model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  skills      Skill[]
}

model Skill {
  id                  String               @id @default(uuid())
  name                String               @unique
  baseRate            Decimal
  rateUnit            RateUnit             @default(HOURLY)
  categoryId          String?
  category            Category?            @relation(fields: [categoryId], references: [id])
  instantRequests     InstantRequest[]
  instantRequestItems InstantRequestItem[]
  jobs                Job[]
  workers             WorkerSkill[]
  pricingRule         PricingRule?

  @@index([categoryId])
}

model WorkerSkill {
  id       String        @id @default(uuid())
  workerId String
  skillId  String
  skill    Skill         @relation(fields: [skillId], references: [id])
  worker   WorkerProfile @relation(fields: [workerId], references: [id])

  @@unique([workerId, skillId])
}

model AgentWorker {
  id              String        @id @default(uuid())
  agentId         String
  workerId        String
  // The Agent's own "I vouch for this worker" trust flag — scoped to this roster link only,
  // separate from User.isVerified (Admin's platform-wide compliance verification).
  verifiedByAgent Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  agent           AgentProfile  @relation(fields: [agentId], references: [id], onDelete: Cascade)
  worker          WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@unique([agentId, workerId])
  @@index([agentId])
  @@index([workerId])
}

model Job {
  id              String        @id @default(uuid())
  title           String
  description     String?
  latitude        Float?
  longitude       Float?
  address         String?
  city            String?
  state           String?
  pincode         String?
  budget          Decimal?
  requiredWorkers Int
  // When the work should happen. Empty means "as soon as possible".
  scheduledAt     DateTime?
  status          JobStatus     @default(OPEN)
  providerId      String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  skillId         String
  applications    Application[]
  bookings        Booking[]
  provider        User          @relation("ProviderJobs", fields: [providerId], references: [id])
  skill           Skill         @relation(fields: [skillId], references: [id])

  @@index([providerId])
  @@index([skillId])
  @@index([status])
}

model Application {
  id            String            @id @default(uuid())
  jobId         String
  workerId      String?
  agentId       String?
  bidAmount     Decimal?
  workerCount   Int?
  status        ApplicationStatus @default(PENDING)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  applicantType ApplicantType
  message       String?
  agent         AgentProfile?     @relation(fields: [agentId], references: [id])
  job           Job               @relation(fields: [jobId], references: [id])
  worker        WorkerProfile?    @relation(fields: [workerId], references: [id])

  @@unique([jobId, workerId])
  @@unique([jobId, agentId])
  @@index([jobId])
  @@index([workerId])
  @@index([agentId])
  @@index([status])
}

model BookingWorker {
  id         String        @id @default(uuid())
  bookingId  String
  workerId   String
  assignedAt DateTime      @default(now())
  booking    Booking       @relation(fields: [bookingId], references: [id])
  worker     WorkerProfile @relation(fields: [workerId], references: [id])

  @@unique([bookingId, workerId])
}

model Booking {
  id                       String                  @id @default(uuid())
  jobId                    String?
  providerId               String
  workerId                 String?
  agentId                  String?
  amount                   Decimal
  status                   BookingStatus           @default(CREATED)
  startedAt                DateTime?
  completedAt              DateTime?
  createdAt                DateTime                @default(now())
  instantRequestId         String?
  instantRequestResponseId String?                 @unique
  updatedAt                DateTime                @updatedAt
  startOtp                 String?
  type                     BookingType             @default(NORMAL_JOB)
  paymentMode              String                  @default("ONLINE")
  estimatedFare            Decimal                 @default(0.00)
  finalFare                Decimal?
  scheduledAt              DateTime?
  durationHours            Decimal?
  latitude                 Decimal?
  longitude                Decimal?
  address                  Json?
  notes                    String?
  deletedAt                DateTime?
  // Agent-managed-worker payout tracking only — the Agent manually settles what a worker has
  // earned (cash or bank transfer, outside the app) and marks it paid here. Not used for
  // self-managed-worker bookings, which still settle via the Wallet as before.
  payoutPaidAt             DateTime?
  payoutMethod             String?
  // Separate from the above — this is the Agent's own commission on this booking being claimed
  // from the company (their salary arrangement, handled outside the app). Independent of
  // whether the worker has been paid yet.
  commissionCheckedOutAt   DateTime?
  // Agent-managed bookings: the workers' share is first paid to the agent in one lump
  // (workerFundsRequest), and only then does the agent hand each worker their part.
  // The agent's own commission is claimed through commissionRequest.
  workerFundsRequestId     String?
  workerFundsRequest       PayoutRequest?          @relation("WorkerFundsRequest", fields: [workerFundsRequestId], references: [id])
  workerFundsReleasedAt    DateTime?
  commissionRequestId      String?
  commissionRequest        PayoutRequest?          @relation("CommissionRequest", fields: [commissionRequestId], references: [id])
  // Cash bookings of an agent: the agent collected the money, so the platform's share is owed
  // by the agent. It is netted off their next payout (duesRequest) and stamped settled when
  // that payout is paid.
  duesRequestId            String?
  duesRequest              PayoutRequest?          @relation("DuesRequest", fields: [duesRequestId], references: [id])
  platformDueSettledAt     DateTime?
  // Frozen when the booking is created, so later admin price changes cannot alter it. amount is
  // the total the provider pays; workAmount is what the worker earns (all of their work charge);
  // agentAmount is the agent cut, paid out of the platform side. Null on older bookings.
  workAmount               Decimal?
  agentAmount              Decimal?
  agent                    AgentProfile?           @relation(fields: [agentId], references: [id])
  instantRequest           InstantRequest?         @relation(fields: [instantRequestId], references: [id])
  response                 InstantRequestResponse? @relation(fields: [instantRequestResponseId], references: [id])
  job                      Job?                    @relation(fields: [jobId], references: [id])
  provider                 User                    @relation("ProviderBookings", fields: [providerId], references: [id])
  worker                   WorkerProfile?          @relation(fields: [workerId], references: [id])
  bookingWorkers           BookingWorker[]
  review                   Review?
  otps                     Otp[]
  statusHistory            BookingStatusHistory[]
  chatThread               ChatThread?
  payment                  Payment?

  @@index([providerId])
  @@index([workerId])
  @@index([agentId])
  @@index([jobId])
  @@index([instantRequestId])
  @@index([status])
  @@index([scheduledAt])
  @@index([status, createdAt])
}

model BookingStatusHistory {
  id         String        @id @default(uuid())
  bookingId  String
  booking    Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  fromStatus BookingStatus
  toStatus   BookingStatus
  changedBy  String
  reason     String?
  changedAt  DateTime      @default(now())
}

model Otp {
  id         String     @id @default(uuid())
  purpose    OtpPurpose
  channel    OtpChannel
  identifier String
  codeHash   String
  attempts   Int        @default(0)
  consumedAt DateTime?
  expiresAt  DateTime
  bookingId  String?
  booking    Booking?   @relation(fields: [bookingId], references: [id])
  createdAt  DateTime   @default(now())

  @@index([identifier, purpose, channel])
  @@index([expiresAt])
}

model Review {
  id         String        @id @default(uuid())
  bookingId  String        @unique
  rating     Int
  comment    String?
  createdAt  DateTime      @default(now())
  providerId String
  workerId   String
  booking    Booking       @relation(fields: [bookingId], references: [id])
  provider   User          @relation("ProviderReviews", fields: [providerId], references: [id])
  worker     WorkerProfile @relation(fields: [workerId], references: [id])

  @@index([workerId])
  @@index([providerId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model InstantRequest {
  id          String               @id @default(uuid())
  providerId  String
  skillId     String?
  title       String
  description String?
  latitude    Float
  longitude   Float
  address     String?
  amount      Decimal
  status      InstantRequestStatus @default(OPEN)
  expiresAt   DateTime
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  bookings    Booking[]
  provider    User                 @relation(fields: [providerId], references: [id])
  skill       Skill?               @relation(fields: [skillId], references: [id])
  items       InstantRequestItem[]
  bookingMode BookingMode          @default(DIRECT)
  bids        InstantRequestBid[]

  @@index([providerId])
  @@index([status])
}

model InstantRequestResponse {
  id        String                @id @default(uuid())
  workerId  String
  status    InstantResponseStatus
  createdAt DateTime              @default(now())
  itemId    String
  bookings  Booking?
  item      InstantRequestItem    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  worker    WorkerProfile         @relation(fields: [workerId], references: [id])

  @@unique([itemId, workerId])
}

model InstantRequestItem {
  id              String                   @id @default(uuid())
  requestId       String
  skillId         String
  requiredWorkers Int
  acceptedWorkers Int                      @default(0)
  status          InstantRequestStatus     @default(OPEN)
  request         InstantRequest           @relation(fields: [requestId], references: [id], onDelete: Cascade)
  skill           Skill                    @relation(fields: [skillId], references: [id])
  responses       InstantRequestResponse[]

  @@index([skillId])
  @@index([requestId])
}

model InstantRequestBid {
  id               String           @id @default(uuid())
  instantRequestId String
  workerId         String
  bidAmount        Decimal
  status           InstantBidStatus @default(ACTIVE)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  instantRequest   InstantRequest   @relation(fields: [instantRequestId], references: [id], onDelete: Cascade)
  worker           WorkerProfile    @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@unique([instantRequestId, workerId])
  @@index([instantRequestId])
  @@index([status])
}

model NotificationTemplate {
  id        String   @id @default(uuid())
  type      String
  channel   String
  locale    String   @default("en")
  subject   String?
  body      String
  variables Json?
  updatedAt DateTime @updatedAt

  @@unique([type, channel, locale])
}

model PlatformSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model ChatThread {
  id        String        @id @default(uuid())
  bookingId String        @unique
  booking   Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  messages  ChatMessage[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model ChatMessage {
  id        String     @id @default(uuid())
  threadId  String
  thread    ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderId  String
  content   String
  createdAt DateTime   @default(now())

  @@index([threadId])
}

model SupportTicket {
  id        String                @id @default(uuid())
  userId    String
  user      User                  @relation(fields: [userId], references: [id])
  subject   String
  status    SupportTicketStatus   @default(OPEN)
  priority  SupportTicketPriority @default(MEDIUM)
  messages  SupportMessage[]
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  @@index([userId])
  @@index([status])
}

model SupportMessage {
  id        String        @id @default(uuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderId  String
  content   String
  createdAt DateTime      @default(now())

  @@index([ticketId])
}

model Payment {
  id                String        @id @default(uuid())
  bookingId         String        @unique
  booking           Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  amount            Decimal
  status            PaymentStatus @default(PENDING)
  razorpayOrderId   String?       @unique
  razorpayPaymentId String?       @unique
  razorpaySignature String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

enum PayoutRequestKind {
  WORKER_WALLET // a self-managed worker withdrawing their wallet balance
  AGENT_COMMISSION // an agent claiming their own commission
  AGENT_WORKER_FUNDS // an agent claiming the total owed to their managed workers
}

enum PayoutRequestStatus {
  PENDING
  PAID
  REJECTED
}

// One row per "please pay me" request. Admin pays it outside the app (UPI / bank) and marks it
// PAID with the transaction reference; REJECTED puts the money back (wallet credit, or the
// stamped bookings are released again).
model PayoutRequest {
  id                 String              @id @default(uuid())
  kind               PayoutRequestKind
  status             PayoutRequestStatus @default(PENDING)
  userId             String
  user               User                @relation(fields: [userId], references: [id])
  amount             Decimal
  method             String // UPI or BANK
  upiId              String?
  accountHolderName  String?
  accountNumber      String?
  ifscCode           String?
  bankName           String?
  transactionRef     String?
  rejectionReason    String?
  processedById      String?
  processedAt        DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  fundsBookings      Booking[]           @relation("WorkerFundsRequest")
  commissionBookings Booking[]           @relation("CommissionRequest")
  // How much of the agent's cash dues to the platform was netted off this request. `amount` is
  // what admin actually has to pay, i.e. already after this deduction.
  duesDeducted       Decimal             @default(0)
  duesBookings       Booking[]           @relation("DuesRequest")

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

model Wallet {
  id           String        @id @default(uuid())
  workerId     String        @unique
  worker       WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)
  balance      Decimal       @default(0.00)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  transactions Transaction[]
}

model Transaction {
  id        String   @id @default(uuid())
  walletId  String
  wallet    Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  amount    Decimal
  type      String // CREDIT or DEBIT
  // Unique so a redelivered RabbitMQ message (e.g. consumer crashes after crediting but
  // before acking) can't double-pay — the second insert attempt fails fast instead of
  // silently moving money twice. Every caller today derives this as "{purpose}:{bookingId}",
  // which is naturally unique per booking since each booking settles payment exactly once.
  reference String   @unique
  createdAt DateTime @default(now())
}

// Admin-managed min/max fare caps per Skill. Normalized out of the generic
// PlatformSetting JSON-blob key ("pricing:rule:{skillId}") it used to live under —
// that key had no writer anywhere in the app, so this is a clean cutover, not a migration.
model PricingRule {
  id        String   @id @default(uuid())
  skillId   String   @unique
  skill     Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  minFare   Decimal?
  maxFare   Decimal?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
