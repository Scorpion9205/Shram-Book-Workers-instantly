// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  WORKER
  PROVIDER
  AGENT
}

enum JobStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ProviderType {
  INDIVIDUAL
  COMPANY
}

enum InstantRequestStatus {
  OPEN
  FILLED
  EXPIRED
  CANCELLED
  COMPLETED
}

enum InstantResponseStatus {
  ACCEPTED
  REJECTED
}

model User {
  id String @id @default(uuid())

  name     String
  phone    String  @unique
  email    String? @unique
  password String

  role UserRole

  address String?
  city    String?
  state   String?
  pincode String?

  profileImage String?

  isActive   Boolean @default(true)
  isVerified Boolean @default(false)

  refreshToken String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workerProfile   WorkerProfile?
  providerProfile ProviderProfile?
  agentProfile    AgentProfile?

  location UserLocation?

  jobsPosted Job[] @relation("ProviderJobs")

  bookingsAsProvider Booking[] @relation("ProviderBookings")

  notifications   Notification[]
  instantRequests InstantRequest[]
}

model UserLocation {
  id String @id @default(uuid())

  userId String @unique

  latitude  Float
  longitude Float

  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model WorkerProfile {
  id String @id @default(uuid())

  userId String @unique

  bio String?

  experience Int @default(0)

  dailyRate Float?

  isAvailable Boolean @default(true)

  rating Float @default(0)

  totalJobs Int @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  skills WorkerSkill[]

  applications Application[]

  bookings                Booking[]
  agentLinks              AgentWorker[]
  instantRequestResponses InstantRequestResponse[]
}

model ProviderProfile {
  id String @id @default(uuid())

  userId String @unique

  companyName String?

  description String?

  rating Float @default(0)

  providerType ProviderType @default(INDIVIDUAL)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AgentProfile {
  id String @id @default(uuid())

  userId String @unique

  agencyName String

  description String?

  rating Float @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  workers AgentWorker[]

  applications Application[]

  bookings Booking[]
}

model Skill {
  id String @id @default(uuid())

  name String @unique

  workers WorkerSkill[]

  instantRequests     InstantRequest[]
  instantRequestItems InstantRequestItem[]
}

model WorkerSkill {
  id String @id @default(uuid())

  workerId String
  skillId  String

  worker WorkerProfile @relation(fields: [workerId], references: [id])

  skill Skill @relation(fields: [skillId], references: [id])

  @@unique([workerId, skillId])
}

model AgentWorker {
  id String @id @default(uuid())

  agentId  String
  workerId String

  agent AgentProfile @relation(fields: [agentId], references: [id])

  worker WorkerProfile @relation(fields: [workerId], references: [id])

  @@unique([agentId, workerId])
}

model Job {
  id String @id @default(uuid())

  title String

  description String?

  latitude  Float
  longitude Float

  address String?
  city    String?
  state   String?
  pincode String?

  budget Float?

  requiredWorkers Int

  status JobStatus @default(OPEN)

  providerId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  provider User @relation("ProviderJobs", fields: [providerId], references: [id])

  applications Application[]

  bookings Booking[]
}

model Application {
  id String @id @default(uuid())

  jobId String

  workerId String?
  agentId  String?

  bidAmount   Float?
  workerCount Int?

  status ApplicationStatus @default(PENDING)

  createdAt DateTime @default(now())

  job Job @relation(fields: [jobId], references: [id])

  worker WorkerProfile? @relation(fields: [workerId], references: [id])

  agent AgentProfile? @relation(fields: [agentId], references: [id])
}

model Booking {
  id String @id @default(uuid())

  jobId String

  providerId String

  workerId String?
  agentId  String?

  amount Float

  status BookingStatus @default(PENDING)

  startedAt   DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())

  job Job @relation(fields: [jobId], references: [id])

  worker WorkerProfile? @relation(fields: [workerId], references: [id])

  agent AgentProfile? @relation(fields: [agentId], references: [id])

  provider User @relation("ProviderBookings", fields: [providerId], references: [id])
}

model Review {
  id String @id @default(uuid())

  bookingId String @unique

  rating Int

  comment String?

  createdAt DateTime @default(now())
}

model Notification {
  id String @id @default(uuid())

  userId String

  title String

  message String

  isRead Boolean @default(false)

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model InstantRequest {
  id String @id @default(uuid())

  providerId String

  title String

  description String?

  latitude  Float
  longitude Float

  address String?

  amount Float

  status InstantRequestStatus @default(OPEN)

  expiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  provider User @relation(fields: [providerId], references: [id])

  items   InstantRequestItem[]
  skill   Skill?               @relation(fields: [skillId], references: [id])
  skillId String?

  @@index([providerId])
  @@index([status])
}

model InstantRequestResponse {
  id String @id @default(uuid())

  itemId String

  workerId String

  status InstantResponseStatus

  createdAt DateTime @default(now())

  item InstantRequestItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  worker WorkerProfile @relation(fields: [workerId], references: [id])

  @@unique([itemId, workerId])
}

model InstantRequestItem {
  id String @id @default(uuid())

  requestId String

  skillId String

  requiredWorkers Int

  acceptedWorkers Int @default(0)

  request InstantRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  skill Skill @relation(fields: [skillId], references: [id])

  responses InstantRequestResponse[]

  @@index([skillId])
}
