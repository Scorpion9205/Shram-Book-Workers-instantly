generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String           @id @default(uuid())
  name               String
  phone              String           @unique
  email              String?          @unique
  password           String
  role               UserRole
  isVerified         Boolean          @default(false)
  refreshToken       String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  address            String?
  isActive           Boolean          @default(true)
  profileImage       String?
  city               String?
  pincode            String?
  state              String?
  agentProfile       AgentProfile?
  bookingsAsProvider Booking[]        @relation("ProviderBookings")
  instantRequests    InstantRequest[]
  jobsPosted         Job[]            @relation("ProviderJobs")
  notifications      Notification[]
  providerProfile    ProviderProfile?
  providerReviews    Review[]         @relation("ProviderReviews")
  location           UserLocation?
  workerProfile      WorkerProfile?
}

model UserLocation {
  id        String   @id @default(uuid())
  userId    String   @unique
  latitude  Float
  longitude Float
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WorkerProfile {
  id                      String                   @id @default(uuid())
  userId                  String                   @unique
  bio                     String?
  experience              Int                      @default(0)
  dailyRate               Float?
  isAvailable             Boolean                  @default(true)
  rating                  Float                    @default(0)
  totalJobs               Int                      @default(0)
  totalReviews            Int                      @default(0)
  agentLinks              AgentWorker[]
  applications            Application[]
  bookings                Booking[]
  bookingWorkers          BookingWorker[]
  instantRequestResponses InstantRequestResponse[]
  reviews                 Review[]
  user                    User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills                  WorkerSkill[]
  instantBids             InstantRequestBid[]
}

model ProviderProfile {
  id           String       @id @default(uuid())
  userId       String       @unique
  companyName  String?
  description  String?
  rating       Float        @default(0)
  providerType ProviderType @default(INDIVIDUAL)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AgentProfile {
  id           String        @id @default(uuid())
  userId       String        @unique
  agencyName   String
  description  String?
  rating       Float         @default(0)
  city         String?
  createdAt    DateTime      @default(now())
  isVerified   Boolean       @default(false)
  phone        String?
  profileImage String?
  state        String?
  updatedAt    DateTime      @updatedAt
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  workers      AgentWorker[]
  applications Application[]
  bookings     Booking[]
}

model Skill {
  id                  String               @id @default(uuid())
  name                String               @unique
  baseRate            Float                @default(0)
  instantRequests     InstantRequest[]
  instantRequestItems InstantRequestItem[]
  jobs                Job[]
  workers             WorkerSkill[]
}

model WorkerSkill {
  id       String        @id @default(uuid())
  workerId String
  skillId  String
  skill    Skill         @relation(fields: [skillId], references: [id])
  worker   WorkerProfile @relation(fields: [workerId], references: [id])

  @@unique([workerId, skillId])
}

model AgentWorker {
  id        String        @id @default(uuid())
  agentId   String
  workerId  String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  agent     AgentProfile  @relation(fields: [agentId], references: [id], onDelete: Cascade)
  worker    WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@unique([agentId, workerId])
  @@index([agentId])
  @@index([workerId])
}

model Job {
  id              String        @id @default(uuid())
  title           String
  description     String?
  latitude        Float?
  longitude       Float?
  address         String?
  city            String?
  state           String?
  pincode         String?
  budget          Float?
  requiredWorkers Int
  status          JobStatus     @default(OPEN)
  providerId      String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  skillId         String
  applications    Application[]
  bookings        Booking[]
  provider        User          @relation("ProviderJobs", fields: [providerId], references: [id])
  skill           Skill         @relation(fields: [skillId], references: [id])

  @@index([providerId])
  @@index([skillId])
  @@index([status])
}

model Application {
  id            String            @id @default(uuid())
  jobId         String
  workerId      String?
  agentId       String?
  bidAmount     Float?
  workerCount   Int?
  status        ApplicationStatus @default(PENDING)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  applicantType ApplicantType
  
  message       String?
  agent         AgentProfile?     @relation(fields: [agentId], references: [id])
  job           Job               @relation(fields: [jobId], references: [id])
  worker        WorkerProfile?    @relation(fields: [workerId], references: [id])

  @@unique([jobId, workerId])
  @@unique([jobId, agentId])
  @@index([jobId])
  @@index([workerId])
  @@index([agentId])
  @@index([status])
}

model BookingWorker {
  id         String        @id @default(uuid())
  bookingId  String
  workerId   String
  assignedAt DateTime      @default(now())
  booking    Booking       @relation(fields: [bookingId], references: [id])
  worker     WorkerProfile @relation(fields: [workerId], references: [id])

  @@unique([bookingId, workerId])
}

model Booking {
  id                       String                  @id @default(uuid())
  jobId                    String?
  providerId               String
  workerId                 String?
  agentId                  String?
  amount                   Float
  status                   BookingStatus           @default(PENDING)
  startedAt                DateTime?
  completedAt              DateTime?
  createdAt                DateTime                @default(now())
  instantRequestId         String?
  instantRequestResponseId String?                 @unique
  updatedAt                DateTime                @updatedAt
  startOtp                 String?
  agent                    AgentProfile?           @relation(fields: [agentId], references: [id])
  instantRequest           InstantRequest?         @relation(fields: [instantRequestId], references: [id])
  response                 InstantRequestResponse? @relation(fields: [instantRequestResponseId], references: [id])
  job                      Job?                    @relation(fields: [jobId], references: [id])
  provider                 User                    @relation("ProviderBookings", fields: [providerId], references: [id])
  worker                   WorkerProfile?          @relation(fields: [workerId], references: [id])
  bookingWorkers           BookingWorker[]
  review                   Review?

  @@index([providerId])
  @@index([workerId])
  @@index([agentId])
  @@index([jobId])
  @@index([instantRequestId])
  @@index([status])
}

model Review {
  id         String        @id @default(uuid())
  bookingId  String        @unique
  rating     Int
  comment    String?
  createdAt  DateTime      @default(now())
  providerId String
  workerId   String
  booking    Booking       @relation(fields: [bookingId], references: [id])
  provider   User          @relation("ProviderReviews", fields: [providerId], references: [id])
  worker     WorkerProfile @relation(fields: [workerId], references: [id])

  @@index([workerId])
  @@index([providerId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model InstantRequest {
  id          String               @id @default(uuid())
  providerId  String
  skillId     String?
  title       String
  description String?
  latitude    Float
  longitude   Float
  address     String?
  amount      Float
  status      InstantRequestStatus @default(OPEN)
  expiresAt   DateTime
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  bookings    Booking[]
  provider    User                 @relation(fields: [providerId], references: [id])
  skill       Skill?               @relation(fields: [skillId], references: [id])
  items       InstantRequestItem[]
  bookingMode BookingMode          @default(DIRECT)
  bids        InstantRequestBid[]

  @@index([providerId])
  @@index([status])
}

model InstantRequestResponse {
  id        String                @id @default(uuid())
  workerId  String
  status    InstantResponseStatus
  createdAt DateTime              @default(now())
  itemId    String
  bookings  Booking?
  item      InstantRequestItem    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  worker    WorkerProfile         @relation(fields: [workerId], references: [id])

  @@unique([itemId, workerId])
}

model InstantRequestItem {
  id              String                   @id @default(uuid())
  requestId       String
  skillId         String
  requiredWorkers Int
  acceptedWorkers Int                      @default(0)
  status          InstantRequestStatus     @default(OPEN)
  request         InstantRequest           @relation(fields: [requestId], references: [id], onDelete: Cascade)
  skill           Skill                    @relation(fields: [skillId], references: [id])
  responses       InstantRequestResponse[]

  @@index([skillId])
}

enum UserRole {
  ADMIN
  WORKER
  PROVIDER
  AGENT
}

enum JobStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ProviderType {
  INDIVIDUAL
  COMPANY
}

enum InstantRequestStatus {
  OPEN
  FILLED
  EXPIRED
  CANCELLED
  COMPLETED
}

enum InstantResponseStatus {
  ACCEPTED
  REJECTED
}

enum ApplicantType {
  WORKER
  AGENT
}

enum BookingMode {
  DIRECT
  BIDDING
}

enum InstantBidStatus {
  ACTIVE
  SELECTED
  REJECTED
  WITHDRAWN
  EXPIRED
}

model InstantRequestBid {
  id               String           @id @default(uuid())
  instantRequestId String
  workerId         String
  bidAmount        Float
  status           InstantBidStatus @default(ACTIVE)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  instantRequest   InstantRequest   @relation(fields: [instantRequestId], references: [id], onDelete: Cascade)
  worker           WorkerProfile    @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@unique([instantRequestId, workerId])
  @@index([instantRequestId])
  @@index([status])
}
